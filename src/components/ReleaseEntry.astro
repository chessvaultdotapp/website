---
import Badge from "./Badge.astro";
interface Props {
  version: string;
  code: string;
}
const { version, code } = Astro.props;
const preview = /\+\d{2}w\d{2}[a-z]+$/.test(version);
---

<article id={version}>
  <div class="release-heading">
    <h2>{version}</h2>
    <Badge variant={preview ? "info" : "success"}>
      <span aria-hidden="true">{preview ? "♟︎" : "♛︎"}</span>
      {preview ? "Preview" : "Stable"}
    </Badge>
  </div>
  <p>
    <a href={`https://github.com/chessvaultdotapp/chessvault/releases/tag/${encodeURIComponent(version)}`}>
      View release on GitHub
    </a>
  </p>
  <div class="release-notes" set:html={code} />
</article>

<style>
  .release-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  article {
    margin-block: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 1rem;
  }
  .release-notes :global(h2) {
    font-size: 1.25rem;
  }
  .release-notes :global(li) {
    margin-block: 0.5rem;
  }
  .release-notes :global(pre) {
    overflow-x: auto;
    padding: 1rem;
  }
  .release-notes :global(img) {
    max-width: 100%;
  }
</style>
