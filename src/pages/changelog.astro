---
import { readFile, readdir } from "node:fs/promises";
import { pathToFileURL } from "node:url";
import { resolve } from "node:path";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Layout from "../layouts/Layout.astro";
import ReleaseEntry from "../components/ReleaseEntry.astro";
import pin from "../../changelogs.json";

// Chessvault's published previews use a week-based build suffix.
const isPreview = (version: string) => /\+\d{2}w\d{2}[a-z]+$/.test(version);
const directory = pathToFileURL(`${resolve(".cache/chessvault")}/`);
let validated;
try {
  validated = JSON.parse(await readFile(new URL("validated.json", directory), "utf8"));
} catch {
  throw new Error("Changelogs are missing. Run pnpm changelogs:fetch before starting or building the website.");
}
if (validated.commit !== pin.commit || validated.tag !== pin.tag) {
  throw new Error("Changelogs are stale. Run pnpm changelogs:fetch to update the pinned snapshot.");
}
const renderer = await createMarkdownProcessor();
const files = (await readdir(new URL("changelogs/", directory))).filter((file) => file.endsWith(".md"));
files.sort((a, b) => b.localeCompare(a, "en", { numeric: true }));
const entries = await Promise.all(
  files.map(async (file) => {
    const version = file.slice(0, -3);
    const markdown = await readFile(new URL(`changelogs/${file}`, directory), "utf8");
    const { code } = await renderer.render(markdown.replace(/^# .*(?:\r?\n|$)/, ""));
    return { version, code };
  }),
);
// These historical v0.0.0 previews led up to the first stable release.
const historical = entries.filter(({ version }) => version.startsWith("v0.0.0+") && isPreview(version));
const current = entries.filter((entry) => !historical.includes(entry));
---

<Layout title="Changelog | Chessvault">
  <div class="changelog">
    <h1>Changelog</h1>
    <p>Release notes for Chessvault, including published development previews.</p>
    {current.map((entry) => (
      <>
        <ReleaseEntry {...entry} />
        {entry.version === "v0.1.0" && historical.length > 0 && (
          <details id="historical-previews">
            <summary>Development previews ({historical.length})</summary>
            {historical.map((preview) => (
              <ReleaseEntry {...preview} />
            ))}
          </details>
        )}
      </>
    ))}
  </div>
</Layout>

<script>
  // Open collapsed notes for navigation links and direct/bookmarked URLs.
  const revealRelease = () => {
    let id;
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    const details = target?.closest("details");
    if (details && target) {
      details.open = true;
      target.scrollIntoView();
    }
  };
  window.addEventListener("hashchange", revealRelease);
  revealRelease();
</script>

<style>
  .changelog {
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    overflow-wrap: anywhere;
  }
  summary {
    cursor: pointer;
    padding-block: 0.5rem;
    font-weight: 700;
  }
  #historical-previews {
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
  }
</style>
